# Integração com a API do Placar Clube (Laravel, módulo "Placar Clube").
# Copie este arquivo para .env e preencha com os valores do ambiente
# (peça ao time Laravel: token gerado via `php artisan placar:token node-dev`).

# Base da API, SEM o sufixo /api/placar (o cliente adiciona esse prefixo).
LARAVEL_BASE_URL=http://localhost:8000

# Token pessoal com a ability `placar:operar`.
LARAVEL_API_TOKEN=
